{
  "expo": {
    "name": "Jobbbox",
    "slug": "jobbbox",
    "scheme": "jobbbox",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "ai.jobbbox.app",
      "supportsTablet": true,
      "deploymentTarget": "16.4",
      "infoPlist": {
        "UISupportedInterfaceOrientations": ["UIInterfaceOrientationPortrait"]
      }
    },
    "android": {
      "package": "ai.jobbbox.app"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-screen-orientation",
      ["expo-local-authentication", { "faceIDPermission": "Jobbbox utilise Face ID pour se déverrouiller quand « Verrouiller l'app » est activé dans ses réglages." }],
      ["expo-build-properties", { "android": { "minSdkVersion": 24 } }]
    ]
  }
}
