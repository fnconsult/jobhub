{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_WEB_APP_URL": "https://staging.jobbbox.ai" }
    },
    "staging": {
      "distribution": "store",
      "channel": "staging",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_WEB_APP_URL": "https://staging.jobbbox.ai", "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_WEB_APP_URL": "https://jobbbox.ai", "SENTRY_DISABLE_AUTO_UPLOAD": "true" }
    }
  },
  "submit": {
    "staging": {
      "ios": { "language": "fr-FR", "appName": "Jobbbox", "sku": "ai.jobbbox.app", "metadataPath": "store.config.json" },
      "android": { "track": "internal", "releaseStatus": "completed" }
    },
    "production": {
      "ios": { "language": "fr-FR", "appName": "Jobbbox", "sku": "ai.jobbbox.app", "metadataPath": "store.config.json" },
      "android": { "track": "production", "releaseStatus": "draft" }
    }
  }
}
