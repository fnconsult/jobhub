# The native app's build configuration (ADR-0076). Copy to apps/mobile/.env for a local release build, or set each as
# an EAS environment variable; never commit the values.

# Crash reports (#703): the DSN of the Sentry project created in an organization whose Data Storage Location is the EU
# (Frankfurt), of the form https://<key>@<org>.ingest.de.sentry.io/<project>. Unset, or outside the EU region, the app
# sends no crash report. Development builds never send any.
EXPO_PUBLIC_SENTRY_DSN=

# Uploading a release build's source maps to Sentry, so a crash's stack reads as the sources (EAS secrets).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Set to true to build a release without uploading its source maps (no SENTRY_AUTH_TOKEN at hand).
SENTRY_DISABLE_AUTO_UPLOAD=
