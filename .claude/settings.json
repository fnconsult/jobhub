{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|mcp__github__merge_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/no-legal-merge.mjs\""
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__actions_run_trigger|mcp__github__create_branch|mcp__github__push_files|mcp__github__create_or_update_file|mcp__github__delete_file|mcp__github__create_pull_request|mcp__github__update_pull_request",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/no-promotion.mjs\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(gh pr merge:*)"
    ]
  }
}
