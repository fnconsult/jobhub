# Copy to .env and adjust. Matches docker-compose.yml.
DATABASE_URL=postgres://jobhub:jobhub@localhost:5433/jobhub
# Postgres connections each web app process opens at most (one pool shared by every module; default 10).
# Keep (instances x this) + the worker's under Postgres' max_connections (100 by default).
DATABASE_POOL_MAX=

# --- AI layer (packages/ai, ADR-0007) ---------------------------------------
# Provider accounts and keys are provisioned by a human. In production these come
# from AWS Secrets Manager, injected as environment variables by ECS.
# Personal data (CVs, Profiles, Applications, Tailored Documents) may only reach
# EU-resident endpoints; the layer refuses to start otherwise.

# Run every task on an in-process fake provider (dev and tests only, refused in production).
AI_FAKE=false

# Provider per task: anthropic | mistral | openai (web_search takes a search provider). Model is optional
# (each provider has a default). web_search only accepts a search provider (perplexity | brave | tavily | linkup).
AI_SCORING_PROVIDER=anthropic
AI_SCORING_MODEL=
AI_WRITING_PROVIDER=anthropic
AI_WRITING_MODEL=
AI_COACHING_PROVIDER=anthropic
AI_COACHING_MODEL=
AI_CV_PARSING_PROVIDER=anthropic
AI_CV_PARSING_MODEL=
AI_OFFER_ANALYSIS_PROVIDER=anthropic
AI_OFFER_ANALYSIS_MODEL=
# Job title variants for Job Search queries (given the Search Criteria title alone). Empty = the
# Job Offer analysis provider and model above.
AI_JOB_TITLES_PROVIDER=
AI_JOB_TITLES_MODEL=
# The Back Office Assistant (Administrators). Empty = the coaching provider and model above.
AI_BACK_OFFICE_ASSISTANT_PROVIDER=
AI_BACK_OFFICE_ASSISTANT_MODEL=
# Guardrail checks on the AI Coach's and Back Office Assistant's messages (EU only). Empty = the coaching provider and model above.
AI_GUARDRAIL_PROVIDER=
AI_GUARDRAIL_MODEL=
# The AI judge of Eval Runs, fixed by Jobbbox (never per Coaching Playbook); may be outside the EU, its cases are fictional. Empty = the coaching provider and model above.
AI_EVAL_PROVIDER=
AI_EVAL_MODEL=
# Web search: perplexity (default) | brave | tavily | linkup.
AI_WEB_SEARCH_PROVIDER=perplexity
# Perplexity Agent API model, as provider/model (e.g. perplexity/sonar); empty = its "fast" preset's model.
AI_WEB_SEARCH_MODEL=

# EU AI consent (ADR-0007 amendment): a consenting Candidate's AI calls that carry their identity
# (name, address, phone, email, raw CV text) go to Mistral, whatever the task's provider. Needs
# MISTRAL_API_KEY; without it those calls fail rather than go elsewhere. Model is optional.
AI_IDENTITY_MODEL=

# Coaching Playbooks (ADR-0021): they live in the database, written in the Back Office, imported once
# from packages/coach-knowledge by `npm run db:migrate`. Which versions are served follows JOBHUB_TARGET,
# set by deploy/compose.yml (production | staging; e2e in playwright.config.ts): production serves only
# Human-validated versions, every other target the latest. Unset: production under NODE_ENV=production.
# JOBHUB_TARGET=

# Anthropic (Claude, default). Endpoint: auto (default) | bedrock (EU) | vertex (EU) | direct (outside the EU:
# only for tasks without personal data). auto follows the keys entered (here or in the Back Office):
# ANTHROPIC_API_KEY alone = direct, AWS_BEARER_TOKEN_BEDROCK alone (or neither) = Bedrock, both = Bedrock
# for personal data and direct for the rest. Without an EU Claude endpoint, tasks with personal data
# default to Mistral (MISTRAL_API_KEY).
ANTHROPIC_ENDPOINT=auto
ANTHROPIC_API_KEY=
# Bedrock: an EU region where Bedrock serves Claude through bedrock-mantle: eu-north-1 (Stockholm), not
# eu-west-3. Without a Bedrock API key, the AWS credential chain (ECS task role) is used.
BEDROCK_REGION=eu-north-1
AWS_BEARER_TOKEN_BEDROCK=
# Vertex AI: region must be an EU location (europe-*, or eu). Auth: Google application default credentials.
VERTEX_REGION=europe-west1
VERTEX_PROJECT_ID=

# Mistral (EU-hosted).
MISTRAL_API_KEY=

# OpenAI. eu uses the EU data-residency endpoint (requires an EU-residency project).
OPENAI_API_KEY=
OPENAI_DATA_RESIDENCY=eu

# Perplexity: web search only, receives nothing but queries built from Search Criteria or an employer's name (ADR-0007).
PERPLEXITY_API_KEY=

# Search-only web search providers (AI_WEB_SEARCH_PROVIDER=brave | tavily | linkup). Treated as outside the EU:
# they receive nothing but queries built from Search Criteria or an employer's name (ADR-0007).
# Brave Search: AI_WEB_SEARCH_MODEL is not used.
BRAVE_SEARCH_API_KEY=
# Tavily: AI_WEB_SEARCH_MODEL is the search depth (basic, default | advanced | fast | ultra-fast).
TAVILY_API_KEY=
# Linkup: AI_WEB_SEARCH_MODEL is the depth (standard, default | fast | deep | flash).
LINKUP_API_KEY=

# --- Candidate accounts (passwordless sign-in, ADR-0008 / ADR-0011) ---
# Public origin of the web app (magic links, Google redirects and Job Digest email links point here).
# The worker sends the Job Digest emails: give it APP_URL, BREVO_API_KEY (or SMTP_URL) and MAIL_FROM too.
APP_URL=http://localhost:3000
# 32+ random characters signing session cookies (openssl rand -base64 32). Required in production.
AUTH_SECRET=
# Outgoing email: Brevo's API key (xkeysib-…, Brevo → SMTP & API → API Keys), used over SMTP_URL when both are set.
# MAIL_FROM must be a sender verified in Brevo. Without either in development, emails (and sign-in links) are
# printed to the server log. A production build refuses to start sign-ins without one, unless MAIL_TRANSPORT=console
# (local e2e only). BREVO_API_URL overrides https://api.brevo.com/v3 (e2e).
BREVO_API_KEY=
SMTP_URL=
MAIL_FROM="Jobbbox <hello@jobbbox.ai>"
# MAIL_TRANSPORT=console
# Job Digests (worker): lowest Match Score a Job Offer needs (0–100, default 60), and how many Job Offers a
# Job Digest aims for (default 10); Job discovery runs only when the stored Job Offers give fewer. How many
# days back a Profile's first Job Digest looks for stored Job Offers (0–90, default 7; 0: Job discovery's only).
JOB_DIGEST_MIN_MATCH_SCORE=
JOB_DIGEST_TARGET_COUNT=
JOB_DIGEST_FIRST_LOOK_BACK_DAYS=
# Job discovery budget (worker): a run (Job Search or Job Digest top-up) stops reading result pages once it has
# this many Job Offers (default 30), has spent this many euros on AI calls (estimated, default 0.08), or has run
# this many seconds (default 90, at most 600: the 15-minute Job Search timeout stays the safety net).
JOB_DISCOVERY_BUDGET_JOB_OFFERS=
JOB_DISCOVERY_BUDGET_EUR=
JOB_DISCOVERY_BUDGET_SECONDS=
# France Travail Offres d'emploi API (worker), searched first by Job discovery: an application's client credentials
# from francetravail.io (access is on request, #119). Leave either empty to go without France Travail.
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Google sign-in: OAuth client from Google Cloud console, redirect URI {APP_URL}/api/auth/callback/google. Sign-in
# Providers (Google, Apple, Microsoft, OIDC) are configured in the Back Office's Connexion section (#209): the
# migration seeds this Google client there once (shown to Candidates, allowed for Administrators), and
# GOOGLE_CLIENT_SECRET stays its fallback until a secret is saved there. Leave both empty for no env Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Browser-extension origins that share the web session, comma-separated (chrome-extension://<id>).
EXTENSION_ORIGINS=
# The Chrome Web Store page of the browser extension, offered in Mon compte's Outils. Empty: "coming soon".
EXTENSION_STORE_URL=
# Web app origin baked into the extension build (host permission + session reads).
WXT_WEB_ORIGIN=http://localhost:3000

# --- Plans and billing (Stripe, ADR-0014) ---
# Test-mode keys outside production (a live key is refused there). Without these in development,
# Plan Quotas still apply but nobody can change Plan; production refuses to bill without them.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint {APP_URL}/api/billing/webhook, listening to
# customer.subscription.created / .updated / .deleted, and checkout.session.completed /
# .async_payment_succeeded (Coaching Sessions). Locally: stripe listen --forward-to localhost:3000/api/billing/webhook
STRIPE_WEBHOOK_SECRET=
# Optional fallbacks (#206): Plans are defined in the Back Office (Offre > Plans), each tied to one Stripe product
# whose default Price is sold at checkout and shown on /abonnement. At startup, Standard and Premium without a
# product yet take the product of these Prices (price_…, never the product ID prod_…; startup fails otherwise);
# afterwards the database wins. To be removed in a later release. The customer portal must allow switching
# between the Plans' products.
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PREMIUM=
# One-off Prices (price_…) of the Coaching Session Price (#24): the regular one, and the one discounted
# for Plans with the Coaching Session discount (a Plan Feature, switched on per Plan in the Back Office). Both or neither; without them Candidates cannot pay for Coaching Sessions.
# Human Coaches are paid outside the platform.
STRIPE_PRICE_COACHING_SESSION=
STRIPE_PRICE_COACHING_SESSION_PREMIUM=
# Another Stripe API origin (the e2e suite's fake). Leave empty.
STRIPE_API_URL=
# Back office (/admin): emails of the Jobbbox team's Administrators, comma-separated. They sign in like Candidates.
ADMIN_EMAILS=

# --- Provider Secrets (ADR-0020, docs/ops/provider-secrets.md) ---
# Master keys encrypting the third-party keys super-admins enter in the Back Office (Clés): a key entered
# there replaces the one in this file within a minute, for the web app and the worker alike.
# Comma-separated <version>:<base64 of 32 random bytes> (openssl rand -base64 32), e.g. 1:AbC...=; the highest
# version encrypts, older ones still decrypt until the re-encryption job has moved every row. Give the web app
# and the worker the same list. A bootstrap secret: never entered in the Back Office. Empty: nothing can be
# saved in Clés, every key comes from this file.
SECRETS_MASTER_KEYS=

# --- Enriched Contacts (Premium, #23) ---
# Licensed contact-data provider: lusha | kaspr | apollo. Empty: Enriched Contacts are off.
# Kaspr only enriches known profiles: it cannot find people by company and job title.
CONTACT_ENRICHMENT_PROVIDER=
# Set to true only once the chosen provider's data-processing agreement (DPA) is signed.
# Until then Enriched Contacts stay off, whatever the provider and key.
CONTACT_ENRICHMENT_DPA_SIGNED=false
# The chosen provider's API key (from AWS Secrets Manager in production). Only the active provider's is needed.
LUSHA_API_KEY=
KASPR_API_KEY=
APOLLO_API_KEY=
# Another API origin for the active provider (the e2e suite's fake). Leave empty.
CONTACT_ENRICHMENT_API_URL=
